{
  "compilerOptions": {
    // This package ships to npm and runs on Node, so it is typed as a Node ESM
    // library rather than as a Bun app. Bun is the dev toolchain only.
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",

    // `node` for the runtime the published CLI targets, `bun` for `bun:test`.
    "types": ["node", "bun"],

    "noEmit": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
