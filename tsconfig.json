{
  "compilerOptions": {
    // This package ships to npm and runs on Node, so it is typed as a Node ESM
    // library. Source imports carry `.ts` extensions so Node can run the
    // TypeScript directly; `rewriteRelativeImportExtensions` turns them into
    // `.js` on emit, which is what the published package needs.
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "types": ["node"],

    "noEmit": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
